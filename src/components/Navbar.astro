---
import LanguageSwitch from "./LanguageSwitch.astro";
import { getLangPrefix, getLangFromUrl } from '../lib/i18n/utils';

const prefix = getLangPrefix(getLangFromUrl(Astro.url));
---

<header class="navbar">
  <a href={prefix + '/'}>
    <img class="site-logo" src="/images/jj.webp" alt="JJ" width="40" height="40" fetchpriority="high" />
  </a>

  <div class="nav-lang">
    <LanguageSwitch />
  </div>
</header>
