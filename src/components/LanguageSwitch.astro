---
import { getLangFromUrl, getAlternateRoute, getAlternateLanguage } from '../lib/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const targetLang = getAlternateLanguage(lang);
const alternatePath = getAlternateRoute(currentPath, lang, targetLang);
const hrefs = { [lang]: currentPath, [targetLang]: alternatePath };
---

<nav class="lang-switch" aria-label="Language">
  {(['es', 'en'] as const).map((code, i) => (
    <>
      {i > 0 && <span class="lang-sep" aria-hidden="true">|</span>}
      {code === lang ? (
        <span class="lang-link is-active" aria-current="true" lang={code}>{code.toUpperCase()}</span>
      ) : (
        <a class="lang-link" href={hrefs[code]} hreflang={code} lang={code}>{code.toUpperCase()}</a>
      )}
    </>
  ))}
</nav>
