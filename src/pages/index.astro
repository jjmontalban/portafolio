---
import Layout from "../layouts/Layout.astro";
import { useTranslations, getLocalizedRoute } from '../lib/i18n/utils';
import type { Lang } from '../lib/i18n/utils';

const lang: Lang = 'es';
const t = useTranslations(lang);
---

<Layout
  title={t('meta.title')}
  page="page-home"
  description={t('meta.description')}
>
  <div class="container">
    <section>
      <h1>Joaquín J. Montalbán</h1>

      <p>{t('home.intro')} <a class="section-link" href={getLocalizedRoute(lang, 'about')}>{t('home.intro.link')}</a>.</p>

      <p>{t('home.services')} <a class="section-link" href={getLocalizedRoute(lang, 'services')}>{t('home.services.link')}</a>.</p>

      <p>{t('home.plugins')} <a class="section-link" href={getLocalizedRoute(lang, 'plugins')}>{t('home.plugins.link2')}</a>.</p>

      <a class="cta cta-primary" href={getLocalizedRoute(lang, 'contact')}>{t('cta.default')}</a>
    </section>
  </div>
</Layout>
