---
import { getLangFromUrl, useTranslations, getLocalizedRoute } from '../lib/i18n/utils';

interface Props {
  title: string;
  button?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  button = t('cta.default')
} = Astro.props;
---

<section class="contact-cta">
  <h2>{title}</h2>
  <a class="cta" href={getLocalizedRoute(lang, 'contact')}>{button}</a>
</section>
